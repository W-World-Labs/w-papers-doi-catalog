BIND_HOST=0.0.0.0
BIND_PORT=55221
TRUSTED_CLIENT_IPS=127.0.0.1,::1,198.51.100.20
DOI_CACHE_PATH=/home/w-data/w-papers-doi-catalog/catalog.sqlite
DOI_BACKUP_DIR=/home/w-data/w-papers-doi-catalog/backups
DOI_BACKUP_RETAIN=14
DOI_POSITIVE_TTL_SECONDS=2592000
DOI_NEGATIVE_TTL_SECONDS=21600
DOI_PROVIDER_ORDER=crossref,openalex
CROSSREF_API_BASE=https://api.crossref.org/works
OPENALEX_API_BASE=https://api.openalex.org/works
UPSTREAM_ALLOWED_HOSTS=api.crossref.org,api.openalex.org
UPSTREAM_CONNECT_TIMEOUT_SECONDS=2
UPSTREAM_READ_TIMEOUT_SECONDS=6
UPSTREAM_MAX_RESPONSE_BYTES=2097152
DOI_CATALOG_USER_AGENT=W-Papers-DOI-Catalog/1.0 (+https://papers.example.invalid; mailto:operator@example.invalid)

# Full, offline OpenAlex snapshot. These paths require the split data mounts.
OPENALEX_CATALOG_DB=/mnt/main/w-papers-openalex/openalex.sqlite
OPENALEX_RAW_DIR=/mnt/md0/openalex/snapshots
OPENALEX_MIN_FREE_BYTES=1099511627776
OPENALEX_TRUSTED_CLIENT_IPS=127.0.0.1,::1
OPENALEX_DOWNLOAD_CONNECTIONS=16
OPENALEX_DOWNLOAD_CONTROL_FILE=/etc/w/w-papers-openalex-download-mode.json
# Optional download-only loopback HTTP proxy; empty means direct.
OPENALEX_DOWNLOAD_PROXY=

# W-Radar values are provisioned by Radar; keep secrets out of git.
W_RADAR_URL=https://radar.region-a.example.invalid
W_RADAR_PROJECT_ID=10-15-w-papers-doi-catalog
W_RADAR_CODE=
W_RADAR_API_KEY=
SERVICE_NAME=w-papers-doi-catalog
APP_ENV=production
APP_RELEASE=
