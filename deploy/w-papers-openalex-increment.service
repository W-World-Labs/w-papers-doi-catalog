[Unit]
Description=Stage verified OpenAlex increment (example interval)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/md0/openalex
AssertPathIsMountPoint=/mnt/md0

[Service]
Type=oneshot
User=w-openalex-catalog
Group=w-openalex-catalog
WorkingDirectory=/opt/w/apps/w-papers-doi-catalog
Environment=PYTHONUNBUFFERED=1
Environment=OPENALEX_DOWNLOAD_PROXY=
ExecStart=/opt/w/apps/w-papers-doi-catalog/.venv/bin/python -m app.openalex_increment download --root /mnt/md0/openalex/increments/2026-09-23--2026-10-14 --workers 4
TimeoutStartSec=infinity
TimeoutStopSec=30
Restart=no
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/mnt/md0/openalex/increments/2026-09-23--2026-10-14
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
